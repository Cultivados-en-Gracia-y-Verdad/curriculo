\contentsline {subsubsection}{Efesios 1:8}{18}{subsubsection*.22}%
\contentsline {subsubsection}{en toda sabiduría}{18}{subsubsection*.23}%
\contentsline {subparagraph}{La expresión puede entenderse como la manera en que Dios actuó.}{18}{subparagraph*.24}%
\contentsline {subparagraph}{Dios no obró al azar ni improvisó Su plan de redención.}{18}{subparagraph*.25}%
\contentsline {subparagraph}{Todo lo hizo con perfecta sabiduría.}{18}{subparagraph*.26}%
\contentsline {subparagraph}{En la Escritura, la sabiduría frecuentemente describe la capacidad de llevar a cabo un propósito perfecto.}{19}{subparagraph*.27}%
\contentsline {subparagraph}{En los versículos siguientes Pablo mostrará precisamente cuál era ese propósito.}{19}{subparagraph*.28}%
\contentsline {subparagraph}{La inteligencia expresa discernimiento, comprensión o entendimiento.}{19}{subparagraph*.29}%
\contentsline {subparagraph}{Dios no solamente tuvo un plan perfecto.}{19}{subparagraph*.30}%
\contentsline {subparagraph}{También lo ejecutó con completo entendimiento y conocimiento.}{19}{subparagraph*.31}%
\contentsline {subparagraph}{Estas dos palabras preparan naturalmente la siguiente declaración.}{19}{subparagraph*.32}%
\contentsline {subparagraph}{En el versículo 9 Pablo dirá que Dios dio a conocer el misterio de Su voluntad.}{19}{subparagraph*.33}%
\contentsline {subparagraph}{La sabiduría y la inteligencia de Dios se manifiestan precisamente al revelar ese misterio.}{19}{subparagraph*.34}%
